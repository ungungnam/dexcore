# Server data roots (see CLAUDE.md): never in git
/data/
/result/
/ckpt/

# Vendored upstream repos (28 GB, each with its own .git) and run outputs
/third_party/
/outputs/

# Agent / editor session state, at any depth
.omc/
.claude/

# Generated demonstrations derived from ARCTIC (not redistributable); regenerate with scripts/synthesize.py
/assets/**/*.npy

# Model weights and large artefacts
*.pt
*.pth
*.ckpt
*.safetensors

# Run logs, videos and wandb
*.log
*.pid
wandb/
visualize/videos/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
